    "sourceSlide": 2,
    "originalPrintedNumber": "2",
    "paragraphs": [
      "Modulübersicht",
      "• Umfang: 4 SWS (180 Min pro Woche) über 15 Wochen",
      "• Teilnehmende: 22 Studierende (+/- 2)",
      "• Gruppenstruktur: 6 Gruppen à 3-4 Personen",
      "• Modultyp: Projektmodul (P-Modul) mit selbstgesteuertem Lernen"
    ],
    "sources": [
